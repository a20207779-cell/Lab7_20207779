<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis sesiones de estudio"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#243B53"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organiza y registra tu tiempo de aprendizaje."
        android:textSize="14sp"
        android:textColor="#627D98"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnAgregarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Registrar sesión"/>

    <Button
        android:id="@+id/btnVerGraficos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver gráficos"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis registros"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#243B53"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSesiones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar sesión"/>

</LinearLayout>